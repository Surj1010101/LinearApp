{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd linear/frontend && npm ci && npm run build",
  "outputDirectory": "linear/frontend/dist",
  "installCommand": "cd linear/frontend && npm ci",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
