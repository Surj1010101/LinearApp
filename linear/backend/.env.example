# Linear backend configuration
# Copy this file to ".env" (same folder) and fill in your secrets.
# This file is committed to git as a template; ".env" is gitignored.

# Required — signs/verifies auth tokens. Generate a unique value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional — enables AI-powered insights via Google Gemini (free tier).
# 1. Sign in at https://aistudio.google.com/apikey
# 2. Click "Create API key" (free, no billing setup required).
# 3. Paste the key after the "=" below.
# Leave blank or unset to use the local rule-based fallback instead.
GOOGLE_API_KEY=

# Optional — database connection string. Defaults to local SQLite (linear.db).
# On Render, set this to your Postgres URL (or leave unset to use the
# attached persistent disk with SQLite).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional — comma-separated allowed origins for CORS.
# Defaults to "*" for local dev. In production, set to your Vercel URL(s):
#   CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app
CORS_ORIGINS=*
